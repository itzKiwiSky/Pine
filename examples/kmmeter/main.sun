use taiyo.std.stringTools
use taiyo.std.arrayTools
use taiyo.std.io
use taiyo.std.math

# constante do carro
local kmLitroHora = 12

local ativo = true
local estadoAtual = "menu"
local registros = []

func drawMainMenu() do
    local textDraw = [
        stringTools.repeat("#", 20),
        "\n",
        "Joaozin kilometragens\n",
        stringTools.repeat("#", 20),
        "\n",
        "[1] - Adicionar registro\n",
        "[2] - Remover registro\n",
        "[3] - Listar todos\n",
        "[4] - Sair\n",
        "\n",
    ]

    for (str : textDraw) do
        io.print(str)
    end
end

func main() do
    while(ativo) do
        if (estadoAtual == "menu") do
            drawMainMenu()
            io.print("Opcao: ")
            local inpt = io.readln()
            if (inpt == "1") do
                estadoAtual = "add"
            elseif (inpt == "2") do
                estadoAtual = "remove"
            elseif (inpt == "3") do
                io.println(stringTools.repeat("-", 30))
                for (str : registros) do
                    io.print(" | ", str.id, " | ", str.distancia, " | ", str.litros" | \n")
                    stringTools.repeat("-", 30)
                end
                io.println(stringTools.repeat("-", 30))
            elseif (inpt == "4") do
                io.println("falow jao")
                ativo = false
            end
        elseif (estadoAtual == "add") do
            io.println("Por favor digite o tempo de viagem (ou digite 'cancelar' para voltar ao menu principal): ")
            io.print("|> ")

            local tempoDeViagem = io.readln()

            if (tempoDeViagem == "cancelar") do
                estadoAtual = "menu"
            end

            io.println("Por favor digite a velocidade (ou digite 'cancelar' para voltar ao menu principal): ")
            io.print("|> ")
            local velocidadeMedia = io.readln()

            if (velocidadeMedia == "cancelar") do
                estadoAtual = "menu"
                tempoDeViagem = ""
                velocidadeMedia = ""
            end

            local dist = math.strToFloat(tempoDeViagem) * math.strToFloat(velocidadeMedia)
            local litros = dist / kmLitroHora

            io.print("resultado: ", math.round(litros, 3), "\n")
            arrayTools.add(registros, {id = arrayTools.len(registros) + 1, distancia = dist, litros = math.round(litros, 3)})

            io.println("Registro adicionado com sucesso")
            io.print("\n")

            estadoAtual = "menu"
            tempoDeViagem = ""
            velocidadeMedia = ""
        elseif (estadoAtual == "remove") do
            io.println("Por favor digite o id do registro (ou digite 'cancelar' para voltar ao menu principal): ")
            io.print("|> ")

            local id = io.readln()

            if (id == "cancelar") do
                estadoAtual = "menu"
                id = ""
            end

            arrayTools.remove(registros, math.strToInt(id))
            io.println("Registro removido com sucesso")
            io.print("\n")
        end
    end
end